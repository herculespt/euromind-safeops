include LICENSE README.md CHANGELOG.md SECURITY.md CONTRIBUTING.md GOVERNANCE.md CODE_OF_CONDUCT.md ROADMAP.md
include requirements-ci.txt
recursive-include docs *.md
recursive-include examples *.py *.md
recursive-include tests *.py
recursive-include .github *.md *.yml CODEOWNERS
global-exclude *.py[cod] .env .env.*
prune .git
prune .safeops
prune .venv
